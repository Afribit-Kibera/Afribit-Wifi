# mesh-core: one Caddy in front of the portal (Next.js :3000) and the join
# service and Afribit Mesh beacon (controller :8040), and Afribit Chat (CT 130).
#
# Two ways in:
#  - Public: Cloudflare Tunnel -> cloudflared -> 127.0.0.1:80 (plain HTTP on
#    loopback). Let's Encrypt HTTP-01 challenges arrive this way too.
#  - Customers: router -> WireGuard -> 10.254.30.1:443 (TLS). The router's DNS
#    points both names at 10.254.30.1, so customers never need a public edge
#    address before they have paid.
{
	auto_https disable_redirects
}

http://wifi.afribit.africa {
	bind 127.0.0.1
	# Only cloudflared reaches loopback; it sets Cf-Connecting-Ip.
	reverse_proxy 127.0.0.1:3000
}

http://mesh-core.afribit.africa {
	bind 127.0.0.1
	respond 404
}

https://wifi.afribit.africa {
	bind 10.254.30.1
	reverse_proxy 127.0.0.1:3000 {
		# Customers arrive directly; overwrite any header they send.
		header_up Cf-Connecting-Ip {remote_host}
	}
}

https://mesh-core.afribit.africa {
	bind 10.254.30.1
	handle /start {
		@guest remote_ip 10.30.0.0/24
		handle @guest {
			reverse_proxy 127.0.0.1:8040 {
				header_up X-Mesh-Client-IP {remote_host}
				header_up X-Mesh-Proxy-TLS 1
			}
		}
		handle {
			respond 403
		}
	}
	# The Afribit app's mesh beacon (S-14) and chat proof (CR-3b). Guests only, as for
	# /start: the controller signs for the address Caddy saw, so it must be the guest's own.
	@meshWellKnown path /.well-known/afribit-mesh-beacon /.well-known/afribit-mesh-proof
	handle @meshWellKnown {
		@guest remote_ip 10.30.0.0/24
		handle @guest {
			reverse_proxy 127.0.0.1:8040 {
				header_up X-Mesh-Client-IP {remote_host}
				header_up X-Mesh-Proxy-TLS 1
			}
		}
		handle {
			respond 403
		}
	}
	# Afribit Chat (Saul CT 130, afribit-os infra/chat): the chat gate and the Matrix client
	# API, for guests only, so Chat works on the mesh with the internet line down. CT 130's
	# forwarders accept connections from this host alone. Federation and admin paths are
	# not routed; they fall through to the 404 below.
	@chat path /v1/session /v1/device/revoke /_matrix/client/* /_matrix/media/*
	handle @chat {
		header Cache-Control no-store
		@outsider not remote_ip 10.30.0.0/24
		handle @outsider {
			respond 403
		}
		@directory path /_matrix/client/*/user_directory/search /_matrix/client/*/publicRooms
		handle @directory {
			respond 404
		}
		@gate path /v1/session /v1/device/revoke
		handle @gate {
			request_body {
				max_size 8KB
			}
			reverse_proxy 192.168.100.95:8791
		}
		handle {
			# Media is encrypted before upload; the app keeps images under 2 MB.
			@upload path /_matrix/media/*/upload /_matrix/client/*/media/upload
			request_body @upload {
				max_size 3MB
			}
			reverse_proxy 192.168.100.95:8790
		}
	}
	handle {
		respond 404
	}
}
