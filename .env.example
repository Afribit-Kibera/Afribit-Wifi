# Database (provisioned through Vercel Neon)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin passkey authentication
AUTH_SECRET=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000

# Short, rate-limited access so a phone wallet can pay from behind the portal
PAYMENT_BOOTSTRAP_ENABLED=true
PAYMENT_BOOTSTRAP_MINUTES=3
PAYMENT_BOOTSTRAP_SPEED_KBPS=128
PAYMENT_BOOTSTRAP_COOLDOWN_HOURS=12

# BTCPay Server
BTCPAY_SERVER_URL=https://pay.insats.org
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# Optional M-Pesa collection -> Bitcoin provider. Independent of BTCPay.
# Test keys are for the sandbox script only; they never buy real internet.
BITIKA_ENABLED=false
BITIKA_MODE=test
BITIKA_API_KEY=
BITIKA_LIGHTNING_ADDRESS=
BITIKA_WEBHOOK_SECRET=

# Optional Paystack M-Pesa collection. BTC settlement is a separate dependency.
PAYSTACK_ENABLED=false
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_RECEIPT_EMAIL=
# Keep the existing shared callback; metadata tags do not create a routing bridge.
PAYSTACK_ENGINE_WEBHOOK_URL=https://engine.insats.org/webhooks/paystack/charge
PAYSTACK_TAG=mesh

# Server-only receiving wallet. No automatic outgoing wallet payments.
BLINK_API_URL=https://api.blink.sv/graphql
BLINK_API_KEY=
BLINK_BTC_WALLET_ID=
BLINK_SETTLEMENT_ENABLED=false
INSATS_ENGINE_URL=https://engine.insats.org
INSATS_MESH_SERVICE_KEY=
MESH_LIGHTNING_ADDRESS=spira@blink.sv

# Encrypts recoverable voucher codes at rest (32-byte base64 key)
VOUCHER_ENCRYPTION_KEY=
# Optional independent 32-byte base64 lookup secret. If omitted, lookup uses a
# domain-separated HKDF key derived from VOUCHER_ENCRYPTION_KEY. Keep it stable
# for issued stock; key changes require rehashing encrypted stored codes.
# VOUCHER_LOOKUP_KEY=
# Legacy SHA-256 redemption is OFF unless both UTC dates are configured.
# The expiry must be at most 32 days after the old-stock creation cutoff.
# Prefer rehashing encrypted old stock instead of enabling compatibility.
# VOUCHER_LEGACY_ISSUED_BEFORE=2026-10-06T00:00:00Z
# VOUCHER_LEGACY_LOOKUP_UNTIL=2026-11-07T00:00:00Z

# Authenticates the on-premise gateway agent
GATEWAY_AGENT_TOKEN=

# Isolated Primary native-order consumer, separate from the legacy gateway queue.
# Keep disabled until durable cloud order issuance and customer login handoff pass.
MESH_NATIVE_OPERATOR_ENABLED=false
MESH_ROUTER_SERVICE_KEY=
# Customer automatic lane. Independent from the bounded legacy operator CLI.
MESH_AUTOMATIC_ACCESS_ENABLED=false
MESH_NATIVE_ACCESS_COMMISSIONED=false
MESH_ACCESS_ROUTER_ID=KM-LAB-001
MESH_ACCESS_ENCRYPTION_KEY=
# Local daemon only. Router credentials must never be configured in Vercel.
MESH_AUTOMATIC_AGENT_ENABLED=false
MESH_CLOUD_URL=https://wifi.afribit.africa
# The commissioned controller uses a loopback agent behind its trusted TLS proxy.
# Browser headers cannot attest clients; see Doc/mesh/mesh-secure-join.md.
# Six-digit voucher attempts share a durable 15-minute database window.
VOUCHER_GLOBAL_ATTEMPTS_PER_WINDOW=100
VOUCHER_DEVICE_ATTEMPTS_PER_WINDOW=5
VOUCHER_SOURCE_ATTEMPTS_PER_WINDOW=30
# New M-Pesa prompt attempts share durable 15-minute counters. Same-reference
# retries are excluded; changing a browser MAC or request UUID cannot reset them.
CHECKOUT_DEVICE_ATTEMPTS_PER_WINDOW=3
CHECKOUT_PHONE_ATTEMPTS_PER_WINDOW=5
# Local private .env.mesh-native only; do not set router credentials in Vercel.
# MIKROTIK_USERNAME=
# MIKROTIK_PASSWORD=
# MESH_PYTHON=py

# Optional Mesh directory links. Leave blank until services exist at this site.
# Use local HTTP(S) addresses only in the site-specific deployment, never globally.
MESH_LOCAL_BOARD_URL=
MESH_LOCAL_MEDIA_URL=
MESH_LOCAL_LEARNING_URL=
# Set true only AFTER the wallet's actual free-access flow is commissioned.
MESH_BLINK_FREE_ACCESS_ENABLED=false
