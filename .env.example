# Database (provisioned through Vercel Neon)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin passkey authentication
AUTH_SECRET=
ADMIN_ENROLLMENT_SECRET=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000

# Short, rate-limited access so a phone wallet can pay from behind the portal
PAYMENT_BOOTSTRAP_ENABLED=true
PAYMENT_BOOTSTRAP_MINUTES=3
PAYMENT_BOOTSTRAP_SPEED_KBPS=128
PAYMENT_BOOTSTRAP_COOLDOWN_HOURS=12

# BTCPay Server
BTCPAY_SERVER_URL=https://pay.insats.org
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# Encrypts recoverable voucher codes at rest (32-byte base64 key)
VOUCHER_ENCRYPTION_KEY=

# Authenticates the on-premise gateway agent
GATEWAY_AGENT_TOKEN=
